# Copiar a oci-prod.env (NO se sube a git) y llenar UNA vez.
OCI_REGION=sa-bogota-1
OCI_PROFILE=DEFAULT

OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..PEGAME
OCI_BASTION_OCID=ocid1.bastion.oc1.sa-bogota-1.PEGAME
OCI_INSTANCE_OCID=ocid1.instance.oc1.sa-bogota-1.PEGAME

# IP privada de vm-portal-prod
OCI_INSTANCE_IP=12.0.9.58
OCI_SSH_USER=opc

OCI_SSH_KEY=$HOME/.ssh/oci_bastion_dev
OCI_SSH_PUB=$HOME/.ssh/oci_bastion_dev.pub

# Rama a desplegar (no uses el .env IFS de DEV).
APP_BRANCH=cursor/ambiente-prod
APP_HOME=/opt/portal-next

BASTION_SESSION_TTL=10800
