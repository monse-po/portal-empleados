# Portal Empleados HMV — ambiente OCI PROD
# Copiar a /opt/portal-next/.env  (chmod 600, owner portalnext)
# NO copiar el .env de DEV. Realm, client, secret y URI son de producción.

NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1
FOCUS=all

DATABASE_URL=postgresql://portal_app:PASSWORD@127.0.0.1:5432/portal_hmv_prod

# --- IFS PROD (IAM de producción, no hmvtest) ---
# Pedir a configs los valores reales. El código no registra nada en IAM.
IFS_SYSTEM_URL=https://REPLACE-PROD.ifs360.cloud
IFS_REALM=REPLACE-PROD
IFS_USE_REALM_OAUTH=true

IFS_OAUTH_CLIENT_ID=IFS_EMP_PORTAL_USER
IFS_OAUTH_CLIENT_SECRET=
IFS_AUTH_ENABLED=true

# IAM debe tener este redirect_uri EXACTO en el client de PROD
# (Direct Access Grants si el login debe validar clave sin pantalla de IFS).
IFS_OAUTH_REDIRECT_URI=https://hmv-empleados.nubeportal.com/api/auth/callback/ifs

# Microsoft: otra app o la misma, con ESTE callback (no APEX).
# IFS_ENTRA_CLIENT_ID=
# IFS_ENTRA_TENANT=common
# IFS_ENTRA_CLIENT_SECRET=
# IFS_ENTRA_REDIRECT_URI=https://hmv-empleados.nubeportal.com/api/auth/callback/microsoft

IFS_SESSION_SECRET=
