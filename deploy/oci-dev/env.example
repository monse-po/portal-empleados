# Portal Empleados HMV — ambiente OCI DEV
# Copiar a /opt/portal-next/.env  (chmod 600, owner portalnext)
# La persona de configs pega los secretos. No commitear este archivo con valores reales.

NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1
FOCUS=all

# Postgres local (solo localhost). Sustituir PASSWORD.
DATABASE_URL=postgresql://portal_app:PASSWORD@127.0.0.1:5432/portal_hmv_dev

# --- IFS tenant DEV (Keycloak / realm, NO IDCS) ---
# Promoción DEV→TEST→PROD = cambiar estas dos + client.
IFS_SYSTEM_URL=https://hmvdev.ifs360.cloud
IFS_REALM=hmvdev
IFS_USE_REALM_OAUTH=true

# M2M client_credentials. Confirmar que PORTAL_HMV_M2M existe en el tenant DEV
# (la nota de configs lo nombra en hmvtest; si en DEV el client es otro, cambiar aquí).
IFS_OAUTH_CLIENT_ID=PORTAL_HMV_M2M
IFS_OAUTH_CLIENT_SECRET=

# No definir IFS_IDCS_DOMAIN_URL ni IFS_IDCS_* en este ambiente.
# Token URL se deriva de SYSTEM + REALM. Solo override si hace falta:
# IFS_OAUTH_TOKEN_URL=https://hmvdev.ifs360.cloud/auth/realms/hmvdev/protocol/openid-connect/token
# IFS_OAUTH_SCOPE=openid email profile microprofile-jwt

# Login empleado (Microsoft Entra) — pendiente de HMV. Dejar apagado.
IFS_AUTH_ENABLED=false
# IFS_OAUTH_REDIRECT_URI=https://hmv-empleados-dev.nubeportal.com/api/auth/callback/ifs
IFS_SESSION_SECRET=

# Compañía IFS (referencia; el actor real sale de CEmpPortalUserSet)
# HMVINGCO
