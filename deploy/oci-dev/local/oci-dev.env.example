# Copiar a oci-dev.env (NO se sube a git) y llenar UNA vez.
# Región Bogotá HMV
OCI_REGION=sa-bogota-1
OCI_PROFILE=DEFAULT

# Compartment Portal_Empleados (OCID)
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..PEGAME

# Bastion bastion_portal_dev (OCID)
OCI_BASTION_OCID=ocid1.bastion.oc1.sa-bogota-1.PEGAME

# Instancia vm-portal-dev (OCID)
OCI_INSTANCE_OCID=ocid1.instance.oc1.sa-bogota-1.PEGAME

# IP privada de la VM (fija)
OCI_INSTANCE_IP=12.0.7.94
OCI_SSH_USER=opc

# Llave local (sin passphrase) — la que ya tienes
OCI_SSH_KEY=$HOME/.ssh/oci_bastion_dev
OCI_SSH_PUB=$HOME/.ssh/oci_bastion_dev.pub

# App en la VM
APP_BRANCH=cursor/anticipos-proyecto-searchable-select
APP_HOME=/opt/portal-next
PORTAL_OPERATOR_EMAIL=monse@veyron.com.mx

# TTL sesión Bastion en segundos (máx OCI ≈ 10800 = 3h)
BASTION_SESSION_TTL=10800
