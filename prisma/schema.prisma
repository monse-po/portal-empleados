generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RegistroEstadoDb {
  REGISTRADO
  EN_REVISION
  APROBADO
  RECHAZADO
}

enum NotificacionModuloDb {
  TIEMPO
}

enum AnticipoEstadoDb {
  BORRADOR
  LANZADO
  APROBADO
  PAGADO
  RECHAZADO
  CANCELADO
}

enum AnticipoTipoDb {
  GASTO
  VIAJE
}

model Empleado {
  id        String           @id
  nombre    String
  registros RegistroTiempo[]
  anticipos Anticipo[]       @relation("AnticipoBeneficiario")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

/// Rol UAT en la consola: solicitar horas vs autorizar horas.
enum PortalAccesoRol {
  EMPLEADO
  AUTORIZADOR
  AMBOS
}

/// Accesos UAT: login (EmailId IFS) → persona que Monse puede impersonar con ?u=
/// Andamiaje de pruebas; en prod cada usuario entra con su propio SSO.
model PortalAcceso {
  id        String          @id @default(cuid())
  /// EmailId IFS / correo de login (minúsculas).
  email     String          @unique
  nombre    String?
  empNo     String?
  /// EMPLEADO = solicitar horas · AUTORIZADOR = aprobar · AMBOS = los dos.
  rol       PortalAccesoRol @default(EMPLEADO)
  activo    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([activo])
  @@index([rol])
}

model Proyecto {
  id        String           @id
  nombre    String
  cliente   String
  registros RegistroTiempo[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model RegistroTiempo {
  id                String           @id @default(cuid())
  legacyId          String?          @unique
  codigo            String           @unique
  empleadoId        String
  proyectoId        String
  subproyecto       String?
  actividad         String
  tipoHora          String
  horas             Float
  fecha             DateTime
  comentario        String           @default("")
  comentarioRechazo String           @default("")
  aprobador         String?
  estado            RegistroEstadoDb @default(REGISTRADO)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  empleado Empleado @relation(fields: [empleadoId], references: [id])
  proyecto Proyecto @relation(fields: [proyectoId], references: [id])

  @@index([empleadoId, fecha])
  @@index([estado])
}

model Notificacion {
  id               String               @id @default(cuid())
  modulo           NotificacionModuloDb @default(TIEMPO)
  tipo             String
  titulo           String
  mensaje          String
  leida            Boolean              @default(false)
  destinatarioRol  String               @default("gerente")
  empleadoId       String?
  empleadoNombre   String?
  proyectoId       String?
  proyectoCod      String?
  fechaIso         String?
  registrosCount   Int                  @default(1)
  href             String?
  createdAt        DateTime             @default(now())

  @@index([destinatarioRol, leida, createdAt])
}

model Anticipo {
  id                   String           @id @default(cuid())
  codigo               String           @unique
  empleadoId           String
  solicitanteId        String
  solicitanteNombre    String
  beneficiarioNombre   String
  beneficiarioCedula   String?
  paraOtro             Boolean          @default(false)
  proyectoId           String
  proyectoNombre       String
  tipo                 AnticipoTipoDb
  estado               AnticipoEstadoDb @default(LANZADO)
  monto                Float
  divisa               String
  motivo               String
  compania             String
  empCompania          String
  aprobador            String?
  fechaSolicitud       String
  fechaAprob           String?
  pago                 String           @default("Pendiente")
  comentarioAprobacion String           @default("")
  aprobadorNombre      String?
  fechaIda             String?
  fechaRegreso         String?
  destino              String?
  tipoViaje            String?
  cuenta               String?
  banco                String?
  tipoCuenta           String?
  timelineJson         Json             @default("[]")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  empleado Empleado @relation("AnticipoBeneficiario", fields: [empleadoId], references: [id])

  @@index([empleadoId, estado])
  @@index([estado])
  @@index([solicitanteId])
}
